# =============================================================================
# Farmer Decision Dashboard - Environment Configuration
# Copy this file to .env and configure your local settings.
# =============================================================================

# Server Port and Host
PORT=5000
HOST=0.0.0.0

# Application Secret Key for JWT & Session Signing
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Google OAuth 2.0 Credentials (Sign in with Google - Gmail only)
# Required scopes: openid, email, profile (Do NOT request Gmail inbox access)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Open Government Data (data.gov.in) Agmarknet API Key
# Optional: If unset or rate-limited, the system automatically falls back to
# the curated data/prices.csv market database and indicates "Sample Data" in the UI.
DATA_GOV_IN_API_KEY=

# Node.js Companion Backend - Python Interpreter Path (Optional)
# If using the Node.js backend (npm start) on Windows, specify Python path if not on PATH:
# PYTHON_PATH=C:\Users\Admin\AppData\Local\Python\bin\python.exe
