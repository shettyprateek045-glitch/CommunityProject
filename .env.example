# =============================================================================
# Farmer Decision Dashboard - Environment Configuration (.env)
# Copy this file to .env and configure your local settings.
# =============================================================================

# Server Port and Host
PORT=5000
HOST=0.0.0.0

# Application Secret Key for JWT & Session Signing
SECRET_KEY=farmer-decision-secret-key-2026

# Google OAuth 2.0 Credentials (Sign in with Google - Gmail only)
# 1. Google Cloud Console -> Create Project
# 2. OAuth Consent Screen -> External
# 3. Credentials -> Create Credentials -> OAuth client ID (Web Application)
# 4. Authorized JS Origins: http://localhost:5000
# 5. Authorized Redirect URI: http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Google Maps Platform (Optional)
# If set, uses Google Maps JS + Geocoding API; otherwise uses Leaflet OpenStreetMap (zero keys needed)
GOOGLE_MAPS_API_KEY=

# AI Cloud LLM API Keys (Connect to Google Gemini or OpenAI ChatGPT for Voice & Step 7 AI Verification Agent)
# Paste either GEMINI_API_KEY or OPENAI_API_KEY to activate live cloud models
GEMINI_API_KEY=
OPENAI_API_KEY=

# Open Government Data (data.gov.in) Agmarknet API Key (Optional)
# If unset, automatically falls back to curated APMC Mandi database (data/prices.csv)
DATA_GOV_API_KEY=
DATA_GOV_IN_API_KEY=

# Open-Meteo Weather API (Free, no key required)
OPEN_METEO_TIMEOUT=5.0
CACHE_TTL_SECONDS=600

# Python Interpreter Path (Optional on Windows if python not in default PATH)
PYTHON_PATH=C:\Users\Admin\AppData\Local\Python\bin\python.exe
